{
  "name": "gatehouse",
  "version": "0.2.3",
  "description": "Gatehouse: simulator for Arduino and RP2040 boards and circuits",
  "main": "main.js",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && node scripts/third-party-licenses.mjs THIRD_PARTY_LICENSES.txt dist/THIRD_PARTY_LICENSES.txt && node -e \"const fs=require('fs'); fs.copyFileSync('NOTICE','dist/NOTICE'); fs.cpSync('licenses','dist/licenses',{recursive:true})\"",
    "typecheck": "tsc",
    "test": "vitest run",
    "start": "npm run build && electron .",
    "licenses": "node scripts/third-party-licenses.mjs",
    "toolchain:fetch": "node scripts/fetch-toolchain.mjs",
    "toolchain:sources": "node scripts/fetch-toolchain-sources.mjs",
    "toolchain:packs": "node scripts/make-packs.mjs",
    "dist": "npm run build && electron-builder --win nsis",
    "dist:setup": "npm run build && electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "26.18.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^5.1.0"
  },
  "allowScripts": {
    "electron@33.4.11": true
  },
  "dependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-cpp": "6.0.3",
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/lang-python": "6.2.1",
    "@codemirror/language": "6.13.1",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@lezer/highlight": "1.2.5",
    "avr8js": "0.21.1",
    "codemirror": "6.0.2",
    "dockview": "8.9.0",
    "fflate": "0.8.3"
  },
  "build": {
    "appId": "io.github.mkumg.gatehouse",
    "productName": "Gatehouse",
    "copyright": "MIT licence",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "electron/*.cjs",
      "electron/installer/*",
      "dist/**/*",
      "package.json",
      "!node_modules/**"
    ],
    "extraResources": [
      {
        "from": "toolchain/packs",
        "to": "toolchain-packs",
        "filter": [
          "manifest.json",
          "*.pack",
          "*.pack.gz"
        ]
      },
      {
        "from": "LICENSE",
        "to": "LICENSE"
      },
      {
        "from": "NOTICE",
        "to": "NOTICE"
      },
      {
        "from": "licenses",
        "to": "licenses"
      }
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/icon.png",
      "artifactName": "Gatehouse-Setup-${version}-classic.exe"
    },
    "portable": {
      "artifactName": "Gatehouse-Setup-${version}.exe"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Gatehouse",
      "deleteAppDataOnUninstall": false
    },
    "publish": null
  }
}
